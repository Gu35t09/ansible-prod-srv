# --- Secrets: neither the vault nor its password goes in the repository ---
# vault.yml stays on the laptop and on the emergency secrets key (maintenance
# guide). If it is ever added with "git add -f", .githooks/pre-commit still
# refuses it unencrypted.
inventory/group_vars/prod_servers/vault.yml
.vault_pass
.vault_pass*
*.vault_pass
vault_pass*.txt

# --- Ansible ---
*.retry
.ansible/

# --- Local tools ---
.jules/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Editor / OS ---
.vscode/
.idea/
*.swp
*~
.DS_Store
