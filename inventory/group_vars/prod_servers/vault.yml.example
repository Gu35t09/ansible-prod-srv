---
# Copy to vault.yml, fill in the values and encrypt it before committing:
#   cp vault.yml.example vault.yml
#   ansible-vault encrypt vault.yml
# The pre-commit hook in .githooks/ refuses an unencrypted vault.yml.

vault_telegram_bot_token: "123456789:REPLACE_ME"
vault_telegram_chat_id: "123456789"

# restic password for both backup copies (at least 20 characters), e.g.
#   openssl rand -base64 33
# Keep a copy outside the server: without it the backups cannot be read.
vault_restic_password: "REPLACE_ME"
# Cloudflare API token for the Let's Encrypt DNS challenge, limited to the
# greyroom.net zone: Zone / Zone / Read and Zone / DNS / Edit.
vault_cloudflare_dns_api_token: "REPLACE_ME"
# Traefik dashboard users, bcrypt htpasswd lines:
#   podman run --rm docker.io/library/httpd:2.4 htpasswd -nbB admin 'password'
vault_traefik_dashboard_users:
  - "admin:$2y$05$REPLACE_ME"

# Immich database password: letters and digits only, e.g.
#   openssl rand -hex 24
vault_immich_db_password: "REPLACE_ME"

# OpenCloud's built-in admin account, used only at the first start (then
# change it in the web interface if needed), e.g.
#   openssl rand -base64 24
vault_opencloud_admin_password: "REPLACE_ME"

# Paperless: database password (letters and digits only, e.g. openssl rand -hex 24),
# secret key (python3 -c "import secrets; print(secrets.token_urlsafe(64))"),
# and the password of its "admin" account (created at the first start).
vault_paperless_db_password: "REPLACE_ME"
vault_paperless_secret_key: "REPLACE_ME"
vault_paperless_admin_password: "REPLACE_ME"

# S3 key limited to the backup bucket.
vault_backup_s3_access_key: "REPLACE_ME"
vault_backup_s3_secret_key: "REPLACE_ME"

# Uptime Kuma push monitors, one per scheduled job: the token is the part
# after /api/push/ in the monitor's push URL (README, "Uptime Kuma").
# A job left out gets no push call.
vault_uptime_kuma_push_tokens:
  backup: "REPLACE_ME"
  clamav: "REPLACE_ME"
  yara: "REPLACE_ME"
  integrity: "REPLACE_ME"
  disk_space: "REPLACE_ME"
  unattended_upgrades: "REPLACE_ME"
