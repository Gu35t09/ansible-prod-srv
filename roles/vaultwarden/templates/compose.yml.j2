# {{ ansible_managed }}
name: vaultwarden

services:
  vaultwarden:
    image: {{ vaultwarden_image }}
    container_name: vaultwarden
    restart: unless-stopped
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    environment:
      DOMAIN: "https://{{ vaultwarden_host }}"
      # Above 1024: with every capability dropped, ports below it cannot be
      # bound inside the container.
      ROCKET_PORT: "8080"
      SIGNUPS_ALLOWED: "{{ 'true' if vaultwarden_signups_allowed | bool else 'false' }}"
      PASSWORD_HINTS_ALLOWED: "false"
      # No ADMIN_TOKEN: the /admin page stays disabled.
      # No Internet access (internal network only): no favicon downloads.
      DISABLE_ICON_DOWNLOAD: "true"
      # Traefik sets X-Real-Ip to the client address (Vaultwarden's default
      # header): failed logins are logged with the real IP.
      LOG_FILE: /logs/vaultwarden.log
    volumes:
      - ./data:/data
      - ./logs:/logs
    tmpfs:
      - /tmp
    # Only the internal network shared with Traefik: no published ports, no
    # route to the Internet, no other service.
    networks:
      - proxy-vaultwarden
    healthcheck:
      test: ["CMD", "/healthcheck.sh"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s

networks:
  proxy-vaultwarden:
    external: true
