#!/bin/bash
# ==============================================================================
# SCRIPT DI SCANSIONE CLAMAV CON NOTIFICA TELEGRAM
# {{ ansible_managed }}
# Contiene il token Telegram: deve restare di proprietà di root con permessi 0700.
# ==============================================================================

BOT_TOKEN={{ telegram_bot_token | quote }}
CHAT_ID={{ telegram_chat_id | quote }}
NOTIFY_ENABLED={{ telegram_notifications_enabled | default(true) | string | lower | quote }}
ACTION={{ clamav_action_on_detect | default('notify_only') | quote }}
QUARANTINE_DIR={{ clamav_quarantine_dir | quote }}
SCAN_PATHS=({% for path in clamav_scan_paths %}{{ path | quote }}{{ ' ' if not loop.last }}{% endfor %})
LOG_DIR="/var/log/clamav"
LOG_RETENTION_DAYS={{ clamav_log_retention_days | int }}
LOG_FILE="${LOG_DIR}/scan_$(date +%Y%m%d_%H%M%S).log"
HOSTNAME=$(hostname)

# Assicurarsi che la directory di log e quarantena esistano
mkdir -p "$LOG_DIR"
if [ "$ACTION" = "quarantine" ]; then
    mkdir -p -m 700 "$QUARANTINE_DIR"
fi

# Pulizia dei log di scansione più vecchi del periodo di conservazione
find "$LOG_DIR" -maxdepth 1 -name 'scan_*.log' -mtime +"$LOG_RETENTION_DAYS" -delete

# Funzione per inviare messaggi su Telegram (testo semplice, senza parse_mode:
# nomi file con caratteri come _ o ` non possono far rifiutare il messaggio).
send_telegram_notification() {
    local message="$1"
    [ "$NOTIFY_ENABLED" = "true" ] || return 0
    if [ -z "$BOT_TOKEN" ] || [ "$BOT_TOKEN" = "YOUR_TELEGRAM_BOT_TOKEN_HERE" ]; then
        echo "Notifica Telegram non inviata: token non configurato." >> "$LOG_FILE"
        return 0
    fi
    # L'URL con il token è passato a curl via stdin (-K -) e non come argomento,
    # così non compare nella lista dei processi (ps).
    if ! printf 'url = "https://api.telegram.org/bot%s/sendMessage"\n' "$BOT_TOKEN" \
        | curl -fsS --max-time 20 -o /dev/null -K - \
            --data-urlencode "chat_id=${CHAT_ID}" \
            --data-urlencode "text=${message}" >> "$LOG_FILE" 2>&1; then
        echo "ERRORE: invio della notifica Telegram fallito." >> "$LOG_FILE"
    fi
}

echo "=== Inizio Scansione ClamAV su $HOSTNAME: $(date) ===" > "$LOG_FILE"

# Utilizziamo clamdscan se il daemon clamd è attivo (molto più veloce), altrimenti clamscan
if pgrep -x "clamd" > /dev/null; then
    SCAN_CMD=(clamdscan --multiscan --fdpass)
else
    echo "ATTENZIONE: clamd non attivo, uso clamscan (più lento)." >> "$LOG_FILE"
    SCAN_CMD=(clamscan -r)
fi

# Aggiunta opzioni in base all'azione configurata
if [ "$ACTION" = "quarantine" ]; then
    SCAN_CMD+=("--move=$QUARANTINE_DIR")
elif [ "$ACTION" = "remove" ]; then
    SCAN_CMD+=(--remove=yes)
fi

# Esecuzione dello scan
"${SCAN_CMD[@]}" "${SCAN_PATHS[@]}" >> "$LOG_FILE" 2>&1
EXIT_CODE=$?

# Interpretazione dei codici di uscita di ClamAV:
# 0 = Nessun virus trovato
# 1 = Trovati file infetti / minacce
# >1 = Si è verificato un errore durante lo scan

if [ $EXIT_CODE -eq 1 ]; then
    INFECTED_COUNT=$(grep -i "Infected files:" "$LOG_FILE" | awk '{print $3}')
    found_files=$(grep "FOUND$" "$LOG_FILE" | head -n 20)

    TEXT=$(cat <<MSG
⚠️ ALLERTA MALWARE CLAMAV ⚠️

🖥️ Server: ${HOSTNAME}
🦠 File infetti rilevati: ${INFECTED_COUNT}
🛠️ Azione eseguita: ${ACTION}
📁 Percorsi scansionati: ${SCAN_PATHS[*]}

📋 File rilevati (max 20):
${found_files}

Log completo: ${LOG_FILE}
MSG
)
    send_telegram_notification "$TEXT"
elif [ $EXIT_CODE -gt 1 ]; then
    TEXT=$(cat <<MSG
❌ ERRORE SCANSIONE CLAMAV

Si è verificato un errore (codice ${EXIT_CODE}) durante la scansione programmata sul server ${HOSTNAME}.
Controllare il log: ${LOG_FILE}
MSG
)
    send_telegram_notification "$TEXT"
else
    echo "Scansione completata. Nessuna minaccia rilevata." >> "$LOG_FILE"
    summary_details=$(grep -i -A 10 "SCAN SUMMARY" "$LOG_FILE" | tail -n 10)
    if [ -z "$summary_details" ]; then
        summary_details=$(tail -n 10 "$LOG_FILE")
    fi

    TEXT=$(cat <<MSG
✅ SCANSIONE CLAMAV COMPLETATA - PULITA

🖥️ Server: ${HOSTNAME}
🦠 File infetti rilevati: 0
📁 Percorsi scansionati: ${SCAN_PATHS[*]}

📋 Dettagli report:
${summary_details}
MSG
)
    send_telegram_notification "$TEXT"
fi

exit $EXIT_CODE
