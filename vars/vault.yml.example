---
# ==============================================================================
# VARIABILI SEGRETE E RISERVATE (ANSIBLE VAULT)
# ==============================================================================
# Questo file contiene credenziali e token sensibili.
# Cripta questo file usando Ansible Vault:
#   ansible-vault encrypt vars/vault.yml
#
# Per modificare il file una volta criptato:
#   ansible-vault edit vars/vault.yml
# ==============================================================================

# Credenziali Bot Telegram per le notifiche ClamAV
vault_telegram_bot_token: "YOUR_TELEGRAM_BOT_TOKEN_HERE"
vault_telegram_chat_id: "YOUR_TELEGRAM_CHAT_ID_HERE"
